# Clave de la API de Anthropic. Sin esto, la seccion de Insights queda apagada
# (el resto de la app funciona igual).  https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Clave de Gemini, si preferis ese proveedor. Tiene nivel gratuito.
GEMINI_API_KEY=

# Modelo usado para los insights. Por defecto claude-opus-5.
# Alternativas mas baratas: claude-sonnet-5, claude-haiku-4-5
WALTRA_MODEL=claude-opus-5

# Opcional: clave compartida para proteger las rutas /api cuando desplegas
# la app en internet.  Si la definis, la app te la pide una vez y la guarda.
WALTRA_ACCESS_KEY=

# OAuth publico de Google (tipo Web). Se compila dentro de web/APK; no es un secreto.
# No hace falta Firebase, client secret, backend ni alojamiento de datos de Waltra.
# Ver docs/google-drive.md para Drive API, consentimiento y cliente Android.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
